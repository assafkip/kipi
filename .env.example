# kipi-investigations — environment template
#
# Copy this to `.env` and fill in your own keys, OR export these in your shell.
#   cp .env.example .env   &&   edit .env
# `.env` is gitignored, so your real keys never get committed.
# Nothing here is a real key — every value is blank on purpose.

# --- Required: the LLM pipeline (Understand / consolidate / analyze / brief) ---
ANTHROPIC_API_KEY=

# --- Optional: OSINT enrichment. Each tool turns ON only when its key is set. ---
# Without these, core infra pivots (whois, DNS, RDAP, crt.sh) still work key-free.
VIRUSTOTAL_API_KEY=
PERPLEXITY_API_KEY=
APIFY_TOKEN=
ABUSECH_AUTH_KEY=

# --- Optional config ---
# Cap a single deep investigator run's cost in USD (lower for a quick demo).
KIPI_DEEP_COST_CAP=5
# Set to 1 to force the pipeline to refuse running without an API key (seatbelt).
KIPI_REQUIRE_API=1
